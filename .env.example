# BreatheWise AI Environment Configuration

# Optional: Google Gemini API Key
# If omitted, BreatheWise AI runs its built-in context-aware expert rule engine with 100% structured validity.
VITE_GEMINI_API_KEY=

# Default AQI Standard: CPCB or US_EPA
VITE_DEFAULT_AQI_STANDARD=CPCB

# Default Environment: production or development
VITE_APP_ENV=production
